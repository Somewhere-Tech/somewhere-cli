    "commander",
    "prompts",
    "semver",
    "sigstore",
    "tar",
    "undici"
  ],
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/prompts": "^2.4.0",
    "@types/semver": "^7.5.8",
    "typescript": "^5.4.0"
  }
