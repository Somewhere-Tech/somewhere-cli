    "node": ">=22.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^4.0.3",
    "commander": "^12.0.0",
    "prompts": "^2.4.2",
    "semver": "^7.6.3",
    "sigstore": "4.1.1",
    "tar": "7.5.20",
    "undici": "^8.4.1"
  },
