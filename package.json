{
  "name": "@somewhere-tech/cli",
  "version": "0.27.3",
  "description": "CLI for somewhere.tech — auth, projects, deploy, pull, promote, db, logs, env, MCP bridge.",
  "keywords": [
    "somewhere",
    "somewhere.tech",
    "cli",
    "deploy",
    "mcp"
  ],
  "homepage": "https://somewhere.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Somewhere-Tech/somewhere-cli.git"
  },
  "license": "MIT",
  "author": {
    "name": "somewhere.tech",
    "email": "support@somewhere.tech"
  },
  "type": "module",
  "bin": {
    "cli": "bin/somewhere.js",
    "somewhere": "bin/somewhere.js",
    "sw": "bin/somewhere.js",
    "swpx": "bin/swpx.js",
    "swpm": "bin/swpm.js"
  },
  "files": [
    "bin",
    "dist",
    "runtime",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
